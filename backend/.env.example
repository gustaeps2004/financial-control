PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Decides what "today" is, and so which months are projections.
APP_TIMEZONE=America/Sao_Paulo

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=financial_control

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h

# "Sign in with Google": the web app's OAuth client ID, from Google Cloud
# (APIs & Services > Credentials). Leave empty to turn Google sign-in off.
# The frontend's VITE_GOOGLE_CLIENT_ID holds the same value.
GOOGLE_CLIENT_ID=
